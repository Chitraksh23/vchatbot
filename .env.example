# Groq API key (free tier) — get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# SerpAPI key (free tier: 100 searches/month) — get one at https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key_here

# Optional: override the Groq model (must support tool calling)
GROQ_MODEL=llama-3.3-70b-versatile
